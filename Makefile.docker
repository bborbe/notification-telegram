DOCKER_REGISTRY ?= docker.io

# BUILD_TARGET selects where `make build` runs. `local` (the default) uses the
# local Docker daemon; any other value names a cluster alias (sun / nukedev /
# nukeprod) or a kubectl context and builds inside that cluster as a Job
# rendered from hack/build-job.yaml.
#
# One-time prerequisite per cluster: it creates the `build` namespace and the
# docker.io push secret the Job mounts.
#   hack/build-cluster-bootstrap.sh <cluster>
#
# The cluster arm publishes at VERSION and never defaults it — pass a scratch
# tag for a trial build, or the release tag when building a release:
#   make build BUILD_TARGET=<cluster> REF=<full-40-char-sha> VERSION=<tag>
BUILD_TARGET ?= local
BUILD_NAMESPACE ?= build
BUILD_TIMEOUT ?= 3600
BUILD_REPO_URL ?= https://github.com/bborbe/$(SERVICE).git
BUILD_DOCKERFILE ?= Dockerfile
BUILD_PUSH_SECRET ?= buildkit-push

# Only the local arm falls back to the latest release tag. The cluster arm must
# name its tag: a default here would republish an already-released tag from
# whatever commit REF points at.
ifeq ($(BUILD_TARGET),local)
ifeq ($(VERSION),)
	VERSION := $(shell git describe --tags `git rev-list --tags --max-count=1`)
endif
endif

# The single image reference both arms publish to. The local arm tags it from
# $(VERSION); the cluster arm pushes the same repository through the
# docker.io-only buildkit-push credential, and nuke's mirror step copies it into
# the private registry the deployment pulls.
IMAGE = $(DOCKER_REGISTRY)/bborbe/$(SERVICE)

.PHONY: build
build: check-go-mod
ifeq ($(BUILD_TARGET),local)
	@if [ -z "$(VERSION)" ]; then echo "ERROR: no VERSION set and no git tag found — set VERSION=vX.Y.Z or create a tag" >&2; exit 1; fi
	DOCKER_BUILDKIT=1 \
	docker build \
	--pull \
	--no-cache \
	--rm=true \
	--platform=linux/amd64 \
	--build-arg DOCKER_REGISTRY=$(DOCKER_REGISTRY) \
	--build-arg BUILD_GIT_COMMIT=$$(git rev-parse --short HEAD) \
	--build-arg BUILD_DATE=$$(date -u +%Y-%m-%dT%H:%M:%SZ) \
	-t $(IMAGE):$(VERSION) \
	-f Dockerfile .
else
# The cluster arm publishes at $(VERSION). REF must be the full 40-character
# SHA: a short ref fails at the clone with `couldn't find remote ref`.
	@if [ -z "$(VERSION)" ]; then echo "ERROR: BUILD_TARGET=$(BUILD_TARGET) needs an explicit VERSION=<tag> — the cluster arm never falls back to the latest release tag" >&2; exit 1; fi
	BUILD_TARGET='$(BUILD_TARGET)' \
	NAMESPACE='$(BUILD_NAMESPACE)' \
	REPO_URL='$(BUILD_REPO_URL)' \
	REF='$(REF)' \
	TAG='$(VERSION)' \
	DOCKERFILE='$(BUILD_DOCKERFILE)' \
	IMAGE='$(IMAGE)' \
	DOCKER_REGISTRY='$(DOCKER_REGISTRY)' \
	PUSH='true' \
	PUSH_SECRET='$(BUILD_PUSH_SECRET)' \
	TIMEOUT='$(BUILD_TIMEOUT)' \
	hack/build-cluster.sh
endif

# The local arm regenerates vendor/ before `docker build`, because the
# Dockerfile builds with `-mod=vendor` while vendor/ is untracked and therefore
# absent from a fresh clone. The cluster arm does that in the Job's vendor init
# container instead: there is nothing to prepare on this host.
.PHONY: check-go-mod
check-go-mod:
ifeq ($(BUILD_TARGET),local)
	@if [ -f "go.mod" ]; then \
		echo "go.mod found, running go mod vendor..."; \
		go mod vendor; \
	else \
		echo "go.mod not found, skipping go mod vendor."; \
	fi
endif

# A remote target pushes from inside the cluster and never loads the image on
# this machine, so there is nothing here to push and nothing to remove. Guard
# both, or `make buca BUILD_TARGET=<cluster>` fails at the push step after a
# build that actually succeeded.
.PHONY: upload
upload:
ifeq ($(BUILD_TARGET),local)
	docker push $(IMAGE):$(VERSION)
endif

.PHONY: clean
clean:
ifeq ($(BUILD_TARGET),local)
	docker rmi $(IMAGE):$(VERSION) || true
	docker image prune -f || true
	docker builder prune --all -f || true
	rm -rf vendor
endif

# Publish-only: no k8s in this repo. Deployment lives in the maintainer Helm
# chart (mirror + keel-pattern). apply is a no-op placeholder.
.PHONY: apply
apply:
	@echo "skip apply — publish-only"

# Operator-run publish to Docker Hub (requires `docker login`). CI runs
# `make precommit`, never `buca`, so the unconditional push is safe.
.PHONY: buca
buca: build upload clean apply
